<Window x:Class="ExamenFinal.View.DetallesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExamenFinal.View"
        xmlns:popups="clr-namespace:ExamenFinal.ViewModel.popUps"
        mc:Ignorable="d"
        Title="DetallesView" Height="450" Width="800"
        DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}}">

    <Grid Margin="10">
        <!-- Definimos las filas para los elementos -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Fila para mostrar ID, Nombre y Cantidad -->
            <RowDefinition Height="Auto"/>
            <!-- Fila para objetos relacionados (Objeto Dos) -->
            <RowDefinition Height="Auto"/>
            <!-- Fila para objetos relacionados (Objeto Tres) -->
        </Grid.RowDefinitions>

        <!-- Mostrar ID, Nombre y Cantidad del objeto -->
        <Grid Grid.Row="0">
            <TextBlock Text="Detalles del Objeto" FontWeight="Bold" FontSize="16" Margin="5"/>
            <Grid Margin="5">
                <TextBlock Text="{Binding Objeto.Id, StringFormat='ID: {0}'}" FontSize="14" Margin="0,20,0,0"/>
                <TextBlock Text="{Binding Objeto.Name, StringFormat='Nombre: {0}'}" FontSize="14" Margin="0,40,0,0"/>
                <TextBlock Text="{Binding TotalObjetosRelacionados, StringFormat='Cantidad: {0}'}" FontSize="14" Margin="0,60,0,0"/>
            </Grid>
        </Grid>

        <!-- Objetos relacionados (Objeto Dos) - DataGrid -->
        <Grid Grid.Row="1">
            <TextBlock Text="Objetos Relacionados (Objeto Dos)" FontWeight="Bold" FontSize="16" Margin="5"/>
            <DataGrid ItemsSource="{Binding ObjetosRelacionadosDos}" AutoGenerateColumns="True" Margin="5" Height="150"/>
        </Grid>

        <!-- Objetos relacionados (Objeto Tres) - DataGrid -->
        <Grid Grid.Row="2">
            <TextBlock Text="Objetos Relacionados (Objeto Tres)" FontWeight="Bold" FontSize="16" Margin="5"/>
            <DataGrid ItemsSource="{Binding ObjetosRelacionadosTres}" AutoGenerateColumns="True" Margin="5" Height="150"/>
        </Grid>

    </Grid>
</Window>
