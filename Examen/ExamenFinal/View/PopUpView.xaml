<Window x:Class="ExamenFinal.View.PopUpView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ExamenFinal.View" 
        xmlns:viewmodel="clr-namespace:ExamenFinal.ViewModel"
        d:DataContext="{d:DesignInstance Type=viewmodel:PopUpViewModel}"
        mc:Ignorable="d"
        Title="PopUpView" 
        Height="500" Width="500"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Nombre -->
        <TextBlock Text="Nombre:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="5" FontWeight="Bold"/>
        <ui:TextBox x:Name="txt_Base" Grid.Row="0" Grid.Column="1" Margin="5"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ingrese el nombre"/>

        <!-- Bool -->
        <TextBlock Text="Bool:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="5" FontWeight="Bold"/>
        <ComboBox x:Name="FuncionaEnConsola" Grid.Row="1" Grid.Column="1" Margin="5"
                  SelectedValue="{Binding BoolOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                  SelectedValuePath="Content">
            <ComboBoxItem Content="True" />
            <ComboBoxItem Content="False" />
        </ComboBox>

        <!-- Imagen -->
        <TextBlock Text="Imagen:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Margin="5" FontWeight="Bold"/>
        <ui:TextBox x:Name="txt_Imagen" Grid.Row="2" Grid.Column="1" Margin="5"
                    Text="{Binding Imagen, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ingrese URL o nombre"/>

        <!-- IdsObjetoDos -->
        <TextBlock Text="Ids Objeto Dos:" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" Margin="5" FontWeight="Bold"/>
        <ui:TextBox x:Name="txt_IdsObjetoDos" Grid.Row="3" Grid.Column="1" Margin="5"
            Text="{Binding IdsObjetoDosTexto, UpdateSourceTrigger=PropertyChanged}" 
            PlaceholderText="Ingrese IDs separados por comas"/>

        <TextBlock Text="Ids Objeto Tres:" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" Margin="5" FontWeight="Bold"/>
        <ui:TextBox x:Name="txt_IdsObjetoTres" Grid.Row="4" Grid.Column="1" Margin="5"
            Text="{Binding IdsObjetoTresTexto, UpdateSourceTrigger=PropertyChanged}" 
            PlaceholderText="Ingrese IDs separados por comas"/>


        <!-- Botones -->
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <ui:Button x:Name="btn_CancelarVentana" Content="Cancelar" Command="{Binding CancelarVentanaCommand}"
                       Appearance="Primary" Width="100" Height="30" Margin="5" Background="Red" Foreground="White"/>
            <ui:Button x:Name="btn_AceptarVentana" Content="Aceptar" Command="{Binding AceptarVentanaCommand}"
                       Appearance="Success" Width="100" Height="30" Margin="5" Background="ForestGreen" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
