<Window x:Class="ExamenFinal.View.AddObjetoTres"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExamenFinal.View"
        xmlns:viewmodel="clr-namespace:ExamenFinal.ViewModel.popUps"
        d:DataContext="{d:DesignInstance Type=viewmodel:AddObjetoTresViewModel}"
        mc:Ignorable="d"
        Title="Añadir ObjetoTres" Height="500" Width="500"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Nombre -->
        <TextBlock Text="Usuario Id:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="5" FontWeight="Bold"/>
        <TextBox x:Name="txt_Name" Grid.Row="0" Grid.Column="1" Margin="5"
                 Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Descripcion -->
        <TextBlock Text="Productos Id:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="5" FontWeight="Bold"/>
        <TextBox x:Name="txt_Descripcion" Grid.Row="1" Grid.Column="1" Margin="5"
                 Text="{Binding Productos, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Id Objeto (Lista) --><!--
        <TextBlock Text="ID Objetos:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Margin="5" FontWeight="Bold"/>
        <TextBox x:Name="txt_IdObjeto" Grid.Row="2" Grid.Column="1" Margin="5"
                 Text="{Binding IdObjeto, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>-->

        <!-- Botones -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="btn_Cancelar" Content="Cancelar" Command="{Binding CancelarCommand}"
                    Width="80" Height="30" Margin="5" Background="Red" Foreground="White"/>
            <Button x:Name="btn_Aceptar" Content="Aceptar" Command="{Binding AceptarCommand}"
                    Width="80" Height="30" Margin="5" Background="ForestGreen" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
